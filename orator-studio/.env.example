# Supabase (optional for local development: without these the app runs in local mode,
# storing decks in the browser, skipping login, and keeping audience sessions in memory).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required when Supabase is configured: audience sessions are written with it.
# Never expose it to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Claude API, used for outline drafting (F-002). Without it, a built-in template outline is used.
ANTHROPIC_API_KEY=

# Hosts that data URL sources may be fetched from (comma separated). Empty: any public host.
SOURCE_ALLOWED_HOSTS=
# Set to 1 on a public server other than Vercel: without sign-in, Claude and URL fetching switch off.
REQUIRE_SIGN_IN=

# Optional: a free NCBI API key (ncbi.nlm.nih.gov → Account settings → API Key Management).
# Raises PubMed's limit from about 3 to 10 requests a second for discovery.
NCBI_API_KEY=
